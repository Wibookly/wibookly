{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "7ef83b20-0a5b-4ce9-b8fc-01dbe29943a2",
  "packageName": "com.energyforward.aiagent",
  "developer": {
    "name": "Nikkore",
    "websiteUrl": "https://energyforward.com",
    "privacyUrl": "https://energyforward.com/privacy",
    "termsOfUseUrl": "https://energyforward.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Nikkore Inbox",
    "full": "Nikkore Inbox Assistant"
  },
  "description": {
    "short": "AI assistant for inbox, calendar, and work tasks",
    "full": "Nikkore Inbox helps you draft emails, summarize documents, prepare for meetings, and analyze data — all inside Microsoft Teams. Your data stays within your Microsoft tenant."
  },
  "accentColor": "#2563EB",
  "bots": [
    {
      "botId": "7ef83b20-0a5b-4ce9-b8fc-01dbe29943a2",
      "scopes": ["personal", "team", "groupchat"],
      "supportsFiles": true,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupchat"],
          "commands": [
            { "title": "Draft email", "description": "Draft a professional email" },
            { "title": "Summarize", "description": "Summarize a document or thread" },
            { "title": "Help", "description": "Show available capabilities" }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["energyforward.com", "*.supabase.co"]
}
