{
  "manifest_version": 3,
  "name": "InboxIQ Meeting Copilot",
  "version": "1.0.0",
  "description": "Live meeting transcript + AI suggestions for Teams, Zoom, Google Meet, and Webex. Audio stays on your machine — no bot joins the call.",
  "permissions": ["tabCapture", "storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": [
    "https://*.teams.microsoft.com/*",
    "https://*.zoom.us/*",
    "https://meet.google.com/*",
    "https://*.webex.com/*",
    "https://inboxiq.energyforward.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://inboxiq.energyforward.com/*",
      "https://*.lovable.app/*"
    ]
  },
  "action": {
    "default_title": "InboxIQ Meeting Copilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  }
}
